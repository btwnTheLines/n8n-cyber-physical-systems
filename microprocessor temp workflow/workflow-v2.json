    {
      "id": "n-load",
      "name": "Load Device State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        80
      ],
      "parameters": {
        "jsCode": "// Load Device State: restore persisted device state or seed defaults.\n// Runs identically on scheduled, manual, and reset-seeded paths.\nconst s = $getWorkflowStaticData('global');\nfunction num(v, d) { return (typeof v === 'number' && Number.isFinite(v)) ? v : d; }\nfunction bool(v, d) { return (typeof v === 'boolean') ? v : d; }\nfunction str(v, d) { return (typeof v === 'string' && v.length > 0) ? v : d; }\nconst temperature = num(s.temperature_c, 45);\nconst fanOn = bool(s.fan_on, false);\nreturn [{ json: {\n  device_id: str(s.device_id, 'cpu-01'),\n  temperature_c: temperature,\n  cpu_load_percent: num(s.cpu_load_percent, 50),\n  fan_state: fanOn ? 'ON' : 'OFF',\n  fan_speed_percent: fanOn ? 100 : 0,\n  status: str(s.status, 'NORMAL'),\n  tick: num(s.tick, 0),\n  heat_bias_c: num(s.heat_bias_c, 0),\n  timestamp: new Date().toISOString()\n} }];\n"
      }
    },
    {
      "id": "n-env",
      "name": "Simulate Environment",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        480,
        80
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "e-note",
              "name": "env_disturbance_armed",
              "type": "boolean",
              "value": true
            }
          ]
        }
      }
    },
    {
      "id": "n-sens",
      "name": "Temperature Sensor",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        720,
        80
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "sn-c",
              "name": "sensor_c",
              "type": "number",
              "value": "={{ $json.temperature_c }}"
            },
            {
              "id": "sn-ok",
              "name": "sensor_ok",
              "type": "boolean",
              "value": true
            }
          ]
        },
        "includeOtherFields": true
      }
    },
    {
      "id": "n-apply",
      "name": "Apply Heating & Cooling",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        80
      ],
      "parameters": {
        "jsCode": "// Apply Heating & Cooling: one deterministic physics tick.\n// Computes cpu_load_percent deterministically (tick 0 -> 50, else\n// 60 + (((tick+1) * 17) % 30)), then heat in from load+bias,\n// passive loss to ambient, active fan cooling.\nconst inp = $input.first().json;\nconst AMBIENT = 25, HEAT = 0.02, PASSIVE = 0.01, COOL = 3.0;\nconst MIN_T = -40, MAX_T = 125;\nfunction num(v, d) { return (typeof v === 'number' && Number.isFinite(v)) ? v : d; }\nconst prevTick = num(inp.tick, 0);\nconst tick = prevTick + 1;\nconst load = prevTick === 0 ? 50 : 60 + (((prevTick + 1) * 17) % 30);\nconst prevT = num(inp.temperature_c, 45);\nconst bias = num(inp.heat_bias_c, 0);\nconst fanOn = inp.fan_state === 'ON';\nlet next = prevT + (load * HEAT + bias) - (prevT - AMBIENT) * PASSIVE - (fanOn ? COOL : 0);\nif (!Number.isFinite(next)) next = prevT;\nnext = Math.min(MAX_T, Math.max(MIN_T, next));\nconst r = Math.round(next * 100) / 100;\nreturn [{ json: Object.assign({}, inp, {\n  cpu_load_percent: load, temperature_c: r, sensor_c: r, tick: tick,\n  timestamp: new Date().toISOString()\n}) }];\n\n"
      }
    },
    {
      "id": "n-save",
      "name": "Save Device State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        80
      ],
      "parameters": {
        "jsCode": "// Save Device State: persist tick result for the next execution.\n// Disturbance override (state_override_c) is consumed here: the\n// temperature is replaced BEFORE the controller IF nodes run, so the\n// normal hysteresis chain decides the fan (no forced fan anywhere).\n// The override is cleared so it acts exactly once.\nconst inp = $input.first().json;\nconst s = $getWorkflowStaticData('global');\nfunction num(v, d) { return (typeof v === 'number' && Number.isFinite(v)) ? v : d; }\nlet temp = num(inp.temperature_c, 45);\nlet disturbed = false;\nif (typeof s.state_override_c === 'number' && Number.isFinite(s.state_override_c)) {\n  temp = Math.min(125, Math.max(-40, s.state_override_c));\n  disturbed = true;\n  delete s.state_override_c;\n}\ns.pending_temperature_c = temp;\ns.pending_disturbed = disturbed;\ns.pending_tick = num(inp.tick, 0);\ns.pending_load = num(inp.cpu_load_percent, 50);\ns.pending_bias = num(inp.heat_bias_c, 0);\ns.persisted_tick = num(inp.tick, 0);\nreturn [{ json: Object.assign({}, inp, {\n  temperature_c: temp, sensor_c: temp, disturbed: disturbed,\n  timestamp: new Date().toISOString()\n}) }];\n\n"
      }
    },
    {
      "id": "n-status",
      "name": "Determine Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2.0,
      "position": [
        1440,
        80
      ],
      "parameters": {
        "jsCode": "// Determine Status: resolve status string from physics + controller context.\n// Runs after Save Device State (disturbance applied) and before Validate Sensor.\nconst inp = $input.first().json;\nfunction num(v, d) { return (typeof v === 'number' && Number.isFinite(v)) ? v : d; }\nconst temp = num(inp.temperature_c, 45);\nconst fanOn = inp.fan_state === 'ON';\nconst disturbed = inp.disturbed === true;\nlet status;\nif (temp >= 80) status = 'OVERHEAT';\nelse if (disturbed) status = 'RECOVERING';\nelse status = fanOn ? 'COOLING' : 'NORMAL';\nreturn [{ json: Object.assign({}, inp, { status: status }) }];\n"
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "v-lo",
              "leftValue": "={{ $json.sensor_c }}",
              "rightValue": -40,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "v-hi",
              "leftValue": "={{ $json.sensor_c }}",
              "rightValue": 125,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
