    {
      "id": "n-commit",
      "name": "Commit State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        80
      ],
      "parameters": {
        "jsCode": "// Commit State: persist the controller-decided result for next tick.\nconst inp = $input.first().json;\nconst s = $getWorkflowStaticData('global');\nfunction num(v, d) { return (typeof v === 'number' && Number.isFinite(v)) ? v : d; }\nfunction str(v, d) { return (typeof v === 'string' && v.length > 0) ? v : d; }\nconst fanOn = inp.fan_state === 'ON';\nlet status = str(inp.status, fanOn ? 'COOLING' : 'NORMAL');\nif (num(inp.temperature_c, 0) >= 80) status = 'OVERHEAT';\ns.device_id = 'cpu-01';\ns.temperature_c = num(inp.temperature_c, 45);\ns.cpu_load_percent = num(inp.cpu_load_percent, 50);\ns.fan_on = fanOn;\ns.status = status;\ns.tick = num(inp.tick, 0);\ns.heat_bias_c = num(inp.heat_bias_c, 0);\ns.updated_at = new Date().toISOString();\nreturn [{ json: Object.assign({}, inp, {\n  status: status, fan_speed_percent: fanOn ? 100 : 0,\n  timestamp: s.updated_at\n}) }];\n"
      }
    },
